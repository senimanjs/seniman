{
  "name": "seniman",
  "version": "0.0.185",
  "description": "",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "type": "module",
  "imports": {
    "#seniman-scheduler-core": {
      "workerd": "./dist/scheduler-core.workerd.js",
      "default": "./dist/scheduler-core.node.js"
    }
  },
  "extensions": [
    ".js"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./types/node.d.ts",
      "default": "./dist/entrypoint.node.js"
    },
    "./router": {
      "types": "./types/router.d.ts",
      "default": "./dist/router/index.js"
    },
    "./entrypoint": {
      "types": "./types/entrypoint.d.ts",
      "default": "./dist/entrypoint.js"
    },
    "./express": {
      "types": "./types/legacy.d.ts",
      "default": "./dist/express/index.js"
    },
    "./server": {
      "types": "./types/legacy.d.ts",
      "default": "./dist/server/index.js"
    },
    "./workers": {
      "types": "./types/legacy.d.ts",
      "default": "./dist/workers/index.js"
    },
    "./hono/workers": {
      "types": "./types/legacy.d.ts",
      "default": "./dist/hono/workers/index.js"
    },
    "./head": {
      "types": "./types/head.d.ts",
      "default": "./dist/head.js"
    },
    "./html": {
      "types": "./types/html.d.ts",
      "default": "./dist/html.js"
    },
    "./_autogen/v1": {
      "types": "./types/autogen-v1.d.ts",
      "default": "./dist/autogen-v1/index.js"
    },
    "./babel": {
      "types": "./types/babel.d.ts",
      "default": "./dist/babel/index.js"
    }
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "npm run test:types && node --test test/*.test.js",
    "test:types": "tsc --project test/types/tsconfig.json",
    "build": "node scripts/build.js",
    "bump": "node scripts/build.js && npm version patch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senimanjs/seniman.git"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/plugin-syntax-jsx": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.7",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "fast-ratelimit": "^3.0.1",
    "nanoid": "^5.1.16",
    "stacktrace-parser": "^0.1.10",
    "ws": "^8.12.0"
  },
  "bugs": {
    "url": "https://github.com/senimanjs/seniman/issues"
  },
  "homepage": "https://github.com/senimanjs/seniman#readme",
  "peerDependencies": {
    "@babel/core": "^7.20.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/node": "^26.0.0",
    "execa": "^7.2.0",
    "typescript": "^7.0.2",
    "uglify-js": "^3.17.4"
  }
}
